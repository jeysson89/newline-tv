<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="40dp"
        android:paddingRight="40dp">

        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:maxWidth="@dimen/splash_logo_max_width"
            android:src="@drawable/splash_logo" />

        <TextView
            android:id="@+id/splashStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@string/splash_loading"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/splash_status_size" />

        <ProgressBar
            android:id="@+id/splashProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="@dimen/splash_progress_width"
            android:layout_height="3dp"
            android:layout_marginTop="18dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/brand_red"
            android:progressTint="@color/brand_red" />

    </LinearLayout>

</FrameLayout>
