<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/channel_card_margin"
    android:background="@drawable/bg_channel_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/channel_card_min_height"
    android:orientation="horizontal"
    android:padding="@dimen/channel_card_padding">

    <FrameLayout
        android:id="@+id/channelLogoBox"
        android:layout_width="@dimen/channel_logo_width"
        android:layout_height="@dimen/channel_logo_height"
        android:background="@drawable/bg_logo_box">

        <ImageView
            android:id="@+id/channelLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <TextView
            android:id="@+id/channelInitials"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/brand_red"
            android:textSize="@dimen/channel_initials_size"
            android:textStyle="bold" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/channel_text_margin"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/channelName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/channel_name_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/channelGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/channel_group_size" />

        <TextView
            android:id="@+id/channelNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/channel_now_size"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
