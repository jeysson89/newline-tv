<?xml version="1.0" encoding="utf-8"?>
<!-- Основная кнопка диалога выхода: красная, при фокусе пультом — белое кольцо. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_red" />
            <corners android:radius="12dp" />
            <stroke
                android:width="3dp"
                android:color="@color/dialog_primary_focus" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_red" />
            <corners android:radius="12dp" />
        </shape>
    </item>

</selector>
