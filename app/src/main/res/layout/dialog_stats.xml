<?xml version="1.0" encoding="utf-8"?>
<!-- Подробности параметров потока: открывается нажатием на мини-кнопку под видео. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_epg_dialog"
    android:orientation="vertical"
    android:paddingLeft="24dp"
    android:paddingTop="22dp"
    android:paddingRight="24dp"
    android:paddingBottom="22dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/stats_title"
        android:textColor="@color/dialog_text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/dialog_divider" />

    <TextView
        android:id="@+id/statsBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/dialog_text_primary"
        android:textSize="15sp" />

    <Button
        android:id="@+id/statsClose"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_epg_close"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:text="@string/settings_close"
        android:textAllCaps="false"
        android:textColor="@color/dialog_button_text"
        android:textSize="17sp" />

</LinearLayout>
